# ========================================================
# OmniRisk: Automated Risk Profile Summarizer
# Environment Configuration Template
# ========================================================

# Google Gemini API Key
# Optional: If not provided, OmniRisk automatically uses its
# built-in deterministic Actuarial Heuristic NLG Engine (100% offline).
# Obtain a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration (optional defaults)
PORT=8000
HOST=127.0.0.1
